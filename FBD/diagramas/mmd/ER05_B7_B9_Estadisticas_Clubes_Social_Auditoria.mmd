    club_lectura ||--o{ miembro_club : "afilia"
    usuario ||--o{ miembro_club : "participa"
    rol_club ||--o{ miembro_club : "asigna rol"
    club_lectura ||--o{ libro_club : "selecciona"
    libro ||--o{ libro_club : "se lee en"
    club_lectura ||--o{ reunion_club : "convoca"
    libro_club |o--o{ reunion_club : "discute libro"
    reunion_club ||--o{ asistencia_reunion : "controla"
    miembro_club ||--o{ asistencia_reunion : "asiste"
    club_lectura ||--o{ mensaje_club : "aloja foro"
    usuario ||--o{ mensaje_club : "publica mensaje"

    usuario ||--o{ seguimiento_usuario : "sigue a"
    usuario ||--o{ seguimiento_usuario : "es seguido por"
    usuario ||--o{ reto_lectura : "organiza"
    reto_lectura ||--o{ participante_reto : "inscribe"
    usuario ||--o{ participante_reto : "compite"
    usuario ||--o{ recomendacion_libro : "recomienda"
    usuario ||--o{ recomendacion_libro : "recibe rec"
    libro ||--o{ recomendacion_libro : "es recomendado"

    usuario |o--o{ auditoria_transaccion : "ejecuta op"
    auditoria_transaccion ||--o{ auditoria_detalle_cambio : "detalla campo"
    dispositivo_usuario ||--o{ sincronizacion_dispositivo : "sincroniza"
    usuario ||--o{ exportacion_datos : "exporta datos"
