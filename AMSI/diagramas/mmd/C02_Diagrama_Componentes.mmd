flowchart TD
    subgraph CapaPresentacion["Capa de Presentación (Frontend / UI)"]
        UI_Web["Cliente Web SPA (HTML5 / Tailwind / Stitch)"]
        UI_Mobile["Cliente Móvil Responsive"]
    end

    subgraph CapaAPI["Capa de Control y Enrutamiento (API Gateway)"]
        Gateway["API Gateway / Router REST"]
        AuthCtrl["SecurityController (Auth / 2FA / RBAC)"]
        CatCtrl["CatalogController"]
        BibCtrl["LibraryController"]
        ReadCtrl["ReadingSessionController"]
        SocCtrl["ClubCommunityController"]
    end

    subgraph CapaServicios["Capa de Servicios y Lógica de Negocio"]
        CryptoSvc["«component» CryptoService (Argon2id / bcrypt / AES-256)"]
        IsbnSvc["«component» IsbnValidatorService (Módulo 10/11)"]
        MetricsSvc["«component» MetricsCalculatorService (PPM / Rachas)"]
        AuditSvc["«component» AuditService (Baja Simbólica / Trazabilidad)"]
        NotifSvc["«component» NotificationService (SMTP / Push)"]
    end

    subgraph CapaDatos["Capa de Acceso a Datos (Persistencia / ORM)"]
        RepoMulti["Data Repository Multi-SGBD"]
        DriverSQLServer["Driver MSSQL Server (ADO.NET / Tedious)"]
        DriverPg["Driver PostgreSQL (Npgsql / pg)"]
    end

    subgraph MotoresBD["Almacenamiento Multi-SGBD"]
        BD_MSSQL[("Microsoft SQL Server 2022 (Corporativo)")]
        BD_Postgres[("PostgreSQL 16 (Software Libre)")]
    end

    UI_Web -->|HTTPS / TLS 1.3| Gateway
    UI_Mobile -->|HTTPS / TLS 1.3| Gateway
    Gateway --> AuthCtrl
    Gateway --> CatCtrl
    Gateway --> BibCtrl
    Gateway --> ReadCtrl
    Gateway --> SocCtrl

    AuthCtrl --> CryptoSvc
    CatCtrl --> IsbnSvc
    ReadCtrl --> MetricsSvc
    AuthCtrl --> AuditSvc
    SocCtrl --> NotifSvc

    AuthCtrl --> RepoMulti
    CatCtrl --> RepoMulti
    BibCtrl --> RepoMulti
    ReadCtrl --> RepoMulti
    SocCtrl --> RepoMulti

    RepoMulti --> DriverSQLServer
    RepoMulti --> DriverPg
    DriverSQLServer --> BD_MSSQL
    DriverPg --> BD_Postgres